# ── App ──────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── MongoDB ──────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=footnote

# ── LLM ──────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# LLM Streaming & Budget (L7, L8)
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS_SHORT=700
LLM_MAX_TOKENS_DETAIL=1600
LLM_TIMEOUT_S=20.0

# ── Embeddings & RAG ──────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_WARMUP=true
VECTOR_INDEX_NAME=chunk_embeddings_index

# Pipeline tunables (L8, A4)
RETRIEVAL_TOP_K=6
RERANK_TOP_K=4
CONTEXT_MAX_TOKENS=2200
MIN_RELEVANCE=0.25

# ── Reranker (L1) ─────────────────────────────────────────────────
# "passthrough" (fast, deduplicates) or "cosine" (legacy, re-embeds)
RERANKER_TYPE=passthrough

# ── Query Rewriting (L4) ──────────────────────────────────────────
# false = fallback to heuristic; true = use LLM if query is anaphoric
ENABLE_LLM_REWRITE=false

# ── File Upload ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
